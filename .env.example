# Template for the environment variables the hub needs, with fake values.
# Copy to .env.local, fill in real values, and never commit that file (.gitignore already blocks it).

# Neon pooled connection string: used by the server at runtime.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Neon direct (non-pooled) connection string: used only by Prisma migrations.
# The Prisma CLI does not load .env files, so load it yourself: set -a && . ./.env.local && set +a
DIRECT_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Direct connection string of a disposable Neon TEST branch: enables the database integration tests.
# Leave it unset to skip them. Never point it at real data.
TEST_DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Master key that locks every provider token: 32 random bytes, base64 encoded.
# Generate one with: openssl rand -base64 32
HUB_MASTER_KEY=

# Optional server settings (defaults shown).
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
