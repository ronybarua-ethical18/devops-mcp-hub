# Files and folders git should never track: dependencies, build output, secrets, local settings.
# Keeps generated code (like the Prisma client) and private files such as .env out of the repo.

# dependencies
node_modules/
.pnp
.pnp.*

# build output
dist/
build/
out/
.next/
next-env.d.ts
*.tsbuildinfo

# tooling caches
.turbo/
.eslintcache
coverage/

# env and secrets (commit .env.example only)
.env
.env.*
!.env.example
*.pem
*.key

# logs
*.log
npm-debug.log*
pnpm-debug.log*
.pnpm-debug.log*

# deployment
.vercel/

# editors and OS
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
.DS_Store
Thumbs.db

# local Claude Code settings
.claude/settings.local.json

# generated Prisma client
packages/db/src/generated/

# superpowers executor scratch
.superpowers/
